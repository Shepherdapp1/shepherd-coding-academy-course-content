  "items": [
    {
      "id": "shepherd.html-starter",
      "kind": "course",
      "title": "HTML: a tiny first page",
      "revision": 1,
      "summary": "A small format-validation sample, not a complete HTML course.",
      "objectives": [
        "Recognize a heading and a paragraph in an HTML fragment."
      ],
      "difficulty": "beginner",
      "estimated_minutes": 30
    },
    {
      "id": "shepherd.html-starter.section.001",
      "kind": "section",
      "title": "First steps",
      "revision": 1,
      "parent_id": "shepherd.html-starter"
    },
    {
      "id": "shepherd.html-starter.module.001",
      "kind": "module",
      "title": "Elements and meaning",
      "revision": 1,
      "parent_id": "shepherd.html-starter.section.001"
    },
    {
      "id": "shepherd.html-starter.topic.001",
      "kind": "topic",
      "title": "Headings and paragraphs",
      "revision": 1,
      "parent_id": "shepherd.html-starter.module.001"
    },
    {
      "id": "shepherd.html-starter.lesson.001",
      "kind": "lesson",
      "title": "Meet an HTML heading",
      "revision": 1,
      "parent_id": "shepherd.html-starter.topic.001",
      "objectives": [
        "Identify an h1 element."
      ],
      "estimated_minutes": 5,
      "body": [
        {
          "kind": "explanation",
          "text": "HTML describes the structure and meaning of a web page."
        },
        {
          "kind": "definition",
          "term": "Element",
          "text": "An element combines tags and content, such as a heading."
        },
        {
          "kind": "code",
          "language": "html",
          "code": "<h1>Hello, Shepherd!</h1>",
          "expected_output": "A top-level heading reading Hello, Shepherd! when rendered in a browser."
        },
        {
          "kind": "note",
          "text": "This package stores examples as text; the validator never renders or executes them."
        }
      ],
      "resources": [
        {
          "title": "MDN: HTML basics",
          "url": "https://developer.mozilla.org/en-US/docs/Learn_web_development/Getting_started/Your_first_website/Creating_the_content"
        }
      ]
    },
    {
      "id": "shepherd.html-starter.lesson.002",
      "kind": "lesson",
      "title": "Add a short paragraph",
      "revision": 1,
      "parent_id": "shepherd.html-starter.topic.001",
      "objectives": [
        "Write a paragraph after a heading."
      ],
      "estimated_minutes": 7,
      "prerequisites": [
        "shepherd.html-starter.lesson.001"
      ],
      "body": [
        {
          "kind": "steps",
          "steps": [
            "Write a heading using h1 tags.",
            "Add a p element beneath it.",
            "Read the source and identify the two elements."
          ]
        },
        {
          "kind": "asset",
          "asset_id": "shepherd.html-starter.asset.001",
          "caption": "Plain-text planning checklist."
        }
      ],
      "exercise_ids": [
        "shepherd.html-starter.exercise.001"
      ],
      "assessment_ids": [
        "shepherd.html-starter.assessment.001"
      ],
      "project_ids": [
        "shepherd.html-starter.project.001"
      ]
    },
    {
      "id": "shepherd.html-starter.exercise.001",
      "kind": "exercise",
      "title": "Write a welcome message",
      "revision": 1,
      "parent_id": "shepherd.html-starter.lesson.002",
      "prompt": "Write an h1 heading and a p paragraph welcoming a new learner.",
      "estimated_minutes": 3,
      "answer_id": "shepherd.html-starter.answer.002",
      "expected_result": "Two complete elements in heading-then-paragraph order."
    },
    {
      "id": "shepherd.html-starter.assessment.001",
      "kind": "assessment",
      "title": "Check the element",
      "revision": 1,
      "parent_id": "shepherd.html-starter.lesson.002",
      "question_ids": [
        "shepherd.html-starter.question.001"
      ],
      "estimated_minutes": 2
    },
    {
      "id": "shepherd.html-starter.question.001",
      "kind": "question",
      "title": "Choose the paragraph element",
      "revision": 1,
      "parent_id": "shepherd.html-starter.assessment.001",
      "prompt": "Which element represents a paragraph?",
      "question_type": "single_choice",
      "options": [
        {
          "id": "a",
          "text": "h1"
        },
        {
          "id": "b",
          "text": "p"
        }
      ],
      "answer_id": "shepherd.html-starter.answer.001"
    },
    {
      "id": "shepherd.html-starter.answer.001",
      "kind": "answer",
      "title": "Paragraph answer",
      "revision": 1,
      "parent_id": "shepherd.html-starter.question.001",
      "explanation": "The p element represents a paragraph; h1 represents a top-level heading.",
      "option_ids": [
        "b"
      ]
    },
    {
      "id": "shepherd.html-starter.answer.002",
      "kind": "answer",
      "title": "Example welcome message",
      "revision": 1,
      "parent_id": "shepherd.html-starter.exercise.001",
      "explanation": "Both elements have opening and closing tags. Other welcoming text is also acceptable.",
      "solution": "<h1>Welcome!</h1>\n<p>Let us learn together.</p>"
    },
    {
      "id": "shepherd.html-starter.project.001",
      "kind": "project",
      "title": "A tiny introduction",
      "revision": 1,
      "parent_id": "shepherd.html-starter.topic.001",
      "requirements": [
        "Include one h1 heading.",
        "Include one p paragraph describing a learning goal."
      ],
      "milestone_ids": [
        "shepherd.html-starter.milestone.001",
        "shepherd.html-starter.milestone.002"
      ],
      "estimated_minutes": 13,
      "rubric": [
        {
          "criterion": "Heading identifies the page topic.",
          "points": 2,
          "milestone_id": "shepherd.html-starter.milestone.001"
        },
        {
          "criterion": "Paragraph states a clear learning goal.",
          "points": 3,
          "milestone_id": "shepherd.html-starter.milestone.002"
        }
      ]
    },
    {
      "id": "shepherd.html-starter.milestone.001",
      "kind": "milestone",
      "title": "Draft the heading",
      "revision": 1,
      "parent_id": "shepherd.html-starter.project.001",
      "requirements": [
        "Write the heading as a complete h1 element."
      ]
    },
    {
      "id": "shepherd.html-starter.milestone.002",
      "kind": "milestone",
      "title": "Complete the paragraph",
      "revision": 1,
      "parent_id": "shepherd.html-starter.project.001",
      "requirements": [
        "Write a complete paragraph after the heading."
      ],
      "prerequisites": [
        "shepherd.html-starter.milestone.001"
      ]
    }
  ],
